+    def terminal_recovery_hold(self, order):
+        altered = False
+        for sent in list(self.unread_replies):
+            reading = self.read_answers([sent])
+            if reading:
+                changed = []
+                self.fold_reading(reading, changed)
+                if changed:
+                    self.version += 1
+                    altered = True
