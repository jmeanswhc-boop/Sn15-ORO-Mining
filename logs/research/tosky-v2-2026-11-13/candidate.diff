+            if not isinstance(value, str) or not self.quoted(value, [quote]):
+                return None
+            if operation == "exclude":
+                text = "not "+value
+            elif operation in ("eq", "constraint", "reference"):
+                text = value
+            else:
+                return None
+        need = prop.strip()+": "+text.strip()
