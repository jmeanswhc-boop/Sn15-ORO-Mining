+    def audit_request(self, brief: dict[str, Any]) -> None:
+        entries = _items(brief.get('items'))
+        if not entries or self.no_credit or self.budget_breached:
+            return
+        parsed = [{k: e.get(k) for k in ('name', 'shelf', 'quantity', 'musts')} for e in entries if isinstance(e, dict)]
+        if len(parsed) != len(entries):
+            return
+        got = self.ask_json(REQUEST_AUDIT + '\n\nREQUEST:\n' + self.request + '\n\nPARSED ITEMS:\n' + _dump(parsed), [LIGHT], 1600)
+        if not isinstance(got, dict):
+            self.trace.append({'kind': 'request_audit', 'status': 'unavailable'})
+            return
+        accepted, rejected = [], 0
+        for amendment in (_items(got.get('add')) + _items(got.get('alternatives')))[:24]:
+            if not isinstance(amendment, dict):
+                rejected += 1
+                continue
+            number = _count(amendment.get('item'))
+            quote = str(amendment.get('quote') or '').strip()
+            if not number or not 1 <= number <= len(entries) or not quote or len(quote) > 600 or not re.search(r'(?<!\w)' + re.escape(_words(quote)) + r'(?!\w)', _words(self.request)):
+                rejected += 1
+                continue
+            entry = entries[number - 1]
+            names = amendment.get('names')
+            if isinstance(names, list):
+                names = list(dict.fromkeys(x.strip() for x in names if isinstance(x, str) and x.strip()))
+                old = _roots(str(entry.get('name') or ''))
+                if 2 <= len(names) <= 6 and re.search(r'\bor\b', quote, re.I) and any(_roots(n) == old for n in names) and all(re.search(r'(?<!\w)' + re.escape(_words(n)) + r'(?!\w)', _words(quote)) for n in names):
+                    entry['name'] = ' or '.join(names)
+                    accepted.append({'item': number, 'alternatives': names, 'quote': quote})
+                else:
+                    rejected += 1
+                continue
+            prop, value = str(amendment.get('property') or '').strip(), str(amendment.get('constraint') or '').strip()
+            words = _value_words(quote)
+            supported = bool(prop and value and len(prop) <= 100 and len(value) <= 300 and _value_words(value) and re.search(r'(?<!\w)' + re.escape(_words(value)) + r'(?!\w)', _words(quote)))
+            operators = re.findall(r"n't|n’t|\b(?:not|without|except|excluding|avoid|or|at least|at most|under|over|below|above|less than|more than)\b", quote.lower())
+            supported = supported and all(op in value.lower() for op in operators)
+            if amendment.get('kind') == 'purpose':
+                direct = bool(re.search(r"\b(?:it|they|this|these|that|those)(?:['’](?:s|re)|\s+(?:is|are|must be|should be|has to be|have to be))\s+(?:(?:meant|intended|designed)\s+)?for\b", quote, re.I))
+                name = str(entry.get('name') or '').strip()
+                direct = direct or bool(name and re.search(r'(?<!\w)' + re.escape(_words(name)) + r'\s+for\b', _words(quote)))
+                supported = supported and direct and (len(entries) == 1 or _roots(name) <= _roots(quote))
+            else:
+                supported = supported and amendment.get('kind') == 'property' and bool(_value_words(prop)) and _value_words(prop) <= words
+            musts = [str(m) for m in _items(entry.get('musts')) if m]
+            existing = [m for m in musts if _same_prop(m.partition(':')[0], prop)]
+            if not supported or existing:
+                rejected += 1
+                continue
+            need = f'{prop}: {value}'
+            entry['musts'] = musts + [need]
+            accepted.append({'item': number, 'need': need, 'quote': quote})
+        self.trace.append({'kind': 'request_audit', 'status': 'reviewed', 'accepted': accepted, 'rejected': rejected})
 
